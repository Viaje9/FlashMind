DATABASE_URL="postgresql://user:password@localhost:5432/flashmind?schema=public"
PORT=3280

# CORS 允許的來源（多個用逗號分隔，未設定則允許 localhost 和區網 IP）
# CORS_ORIGINS="https://example.com,https://app.example.com"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3280/api/auth/google/callback"

# Frontend
FRONTEND_URL="http://localhost:4280"

# Topic Conversation OpenAI Agents SDK
TOPIC_CONVERSATION_TIMEOUT_MS="45000"

# OpenAI API (用於 AI 生成卡片內容)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_SPEAKING_AUDIO_MODEL="gpt-realtime-2.1-mini"
OPENAI_SPEAKING_TRANSCRIPTION_MODEL="gpt-transcribe"
OPENAI_SPEAKING_DEFAULT_VOICE="marin"

# 共用 Codex LLM 設定（卡片 AI、Speaking 文字、Topic Conversation、Collection Agent）
COLLECTION_CODEX_MODEL="gpt-5.5"
COLLECTION_CODEX_REASONING_EFFORT="low"
COLLECTION_CODEX_TIMEOUT_MS="45000"
COLLECTION_CHAT_DEBUG_LOG_ENABLED="true"
COLLECTION_CHAT_DEBUG_LOG_PATH="logs/collection-chat-debug.log"

# Azure Speech Services (用於 TTS 語音合成)
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastasia"

# 白名單（啟用後僅允許指定使用者操作，User ID 以逗號分隔）
# WHITELIST_ENABLED="true"
# WHITELIST_USER_IDS="cuid1,cuid2"
